import QtQuick
import qs.Commons
import qs.Commons as Commons
import qs.Ui as Ui

Column {
  id:root
  property string search:""
  readonly property var sections:[
    {title:"Registry Hub Field Manual",body:"Play builds input actions and sends them through the HTTP daemon to Omarsket. Macrohelp is an overlay/client, never another input engine. Stop cancels pending work and backend tasks. Escape closes the panel without clearing your environment."},
    {title:"Menus and hotkeys",body:"Shift+Alt+0: save pointer. 1: Buffers. 2: Workflow / Registry Hub. 3: Pointer / Circle Placer. 4/5/6: left/right/middle click. 7: Stop. 8: toggle fixed coordinates. 9: Keys. Hotkeys are opt-in examples in bindings.lua; the native Omarchy binding remains authoritative. View controls crosshair, grid, coordinates, fixed panel, key HUD and coordinates-only mode. The Menu button exposes the same actions."},
    {title:"Workflow and environment",body:"Edit brace tokens, then Play. Save schedule exports input-only workflows to the backend. Clipboard/rgd workflows use Play; preserve them with Export environment. Import/Export paths are optional saved locations; Browse uses the native file picker. JSON or Windows text export preserves script, registry path, shell commands, variables, buffers, zones, points, views, last task and transfer paths. Clear resets script-local fields, points, shells and paths but keeps buffers, zones, views and last task."},
    {title:"Variables, paste and references",body:"A/S/D/F are script variables; Z/X/C/V are paste buffers. {set A hello}, {set paste Z text}, {set registry /path/file.md}. $A, $Z, $1…$16, $REGISTRY, $REGEDITED and $SHELLX/C/G/P/T expand saved values. {paste A} pastes without focus-click. {buf Z,X} and {enter A} use configured click-on/off behavior. {click on} enables prepended focus clicks; {click off} disables them. {type literal text} emits a paste block. Use the ordered buffer list for interactive multi-buffer selection."},
    {title:"Points, zones and circle math",body:"{pt 1} / {point 1} moves to a saved point. {set point 3 1200,700}; {set point 4 3} copies point 3. {set point 5 $3} also works. {set zone Z 100,200,500,600}; {set zone Z 1,2} uses saved points 1 and 2; {set zone Z X} copies zone X. Pointer accepts degrees or radians, pi/2 and other arithmetic, screen x,y offsets, i+j vectors (positive j is up), and 316 @ -2i+2j for a scaled direction. Next circle uses the target as its origin. Append/export saves named movement lists; Save + Click includes a click."},
    {title:"Keys, wheel and clicks",body:"Unknown brace tokens become key chords: {CTRL+S}, {ALT_LEFT F4}. Standard left/right modifier aliases, arrows, pageup/pgdn and Tasket names are accepted. {ctrlmod right 3}, {controlmod right 3}, {shiftmod up 2}. {wheelup 3}, {scrollup 3}, {mousewheelup 3}, {MOUSE_WHEEL_DOWN 2} emit counted wheel strokes. {left}, {right}, {middle} click; {wait 200} waits milliseconds. Keys has a categorized three-key picker, focused recording, hold/repeat/delay controls, mixed text/paste steps, reorder/delete, replay and named JSON export/append. Fn is firmware-controlled, not an injectable key. Mouse Hold ms is a bounded timed hold (up to 600000ms), not a permanent key grab."},
    {title:"Shells",body:"{terminal} opens the configured terminal chord only. {bash}/{shell X}, {cmd}/{shell C}, {python}/{py}/{regedited}/{regbin}/{shell G}, {pwsh}/{powershell}/{shell P} open the terminal, wait, type the user-supplied command, then Enter. Blank commands keep its default shell. T overrides the terminal shortcut; blank T follows the active native binding (normally Super+Enter). X/C/G/P commands are user-editable. {set shell X fish}. Install shells yourself. {exec}, {system}, {sys} remain disabled in Registry Hub."},
    {title:"Conditions and schedules",body:"{if A contains text}…{else}…{endif}; notcontains, ==, !=, >, >=, <, <=, empty, notempty. Conditions are evaluated on Play/Save, not continually during a task. {if task last is finished}; {if task 12 state == failed}; {if task 12 remaining <= 2}; {if task 12 message contains done}. {if saved-task Name exists}; missing; {if saved-tasks count > 10}. {play Name.scht} / {play Name.omscht} chains a saved schedule. Task last uses the most recently returned job number. Use waits and another Play when a later status snapshot is needed."},
    {title:"Capture and rgd",body:"{zone Z,Z}: image capture. {zone Z,X}: OCR. C uses the user's single-line/custom OCR shortcut (otherwise regular OCR); V drag-copies. {zonebuf Z,X,V} captures text into buffer V. Z image capture cannot enter a text buffer. Desktop capture tools and shortcuts remain in charge; no OCR package is embedded. {rgdclip i6z6} invokes rgd rg <registry-file> i6z6 --clip. {rgdappend i6z6} appends the clipboard using rgd rs. Regedited owns reference semantics and must be on PATH."},
    {title:"Presets and privacy",body:"Presets save selected code/settings only. {profile 1} resolves a unique name prefix, merges selected fields and expands saved code inline. Import loads a literal preset; Run uses the normal workflow queue. Live PromptFont history is transient, not a keystroke log. Heatmap sessions store aggregates only. The HTTP daemon and backend must be launched separately; offline HTTP requests are quiet. No cloud or telemetry. The static workflow preview is an ordinary HTTP client, not a privileged companion."}
  ]
  spacing:Style.space(8)
  Ui.TextField {width:parent.width;placeholderText:"Search the field manual";text:root.search;onTextEdited:root.search=text}
  Repeater {model:root.sections.filter(function(s){return !root.search||(s.title+" "+s.body).toLowerCase().indexOf(root.search.toLowerCase())>=0});Column {required property var modelData;width:parent.width;spacing:Style.space(5)
    Text {text:parent.modelData.title;textFormat:Text.PlainText;color:Commons.Color.accent;font.family:Style.font.family;font.pixelSize:Style.font.subtitle}
    Text {width:parent.width;wrapMode:Text.Wrap;text:parent.modelData.body;textFormat:Text.PlainText;color:Commons.Color.foreground;font.family:Style.font.family;font.pixelSize:Style.font.body}
  }}
}
