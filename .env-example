# Existing, initialized Omarsket plugin checkout (not a fresh clone).
OMARSKET_INSTALL=/home/YOU/.config/omarchy/plugins/io.github.commanderturtle.omarsket
OMARSKET_SOCKET=/run/user/YOUR_UID/omarsket/control.sock
MACROHELP_BIND=127.0.0.1
MACROHELP_PORT=7777
# http-daemon/wld/build.sh generates a private random value on first invocation.
MACROHELP_API_KEY=
MACROHELP_DEFAULT_DELAY=1
MACROHELP_ALLOW_SYSTEM=false
# Optional: MACROHELP_STATE_DIR=/absolute/private/data/directory
